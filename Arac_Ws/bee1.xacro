<?xml version="1.0"?>
<robot name="bee1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="wheel_radius" value="0.265" />
  <xacro:property name="wheel_width" value="0.15" />
  <xacro:property name="wheelbase" value="1.860" />
  <xacro:property name="front_track" value="0.886" />
  <xacro:property name="rear_track" value="0.850" />

  <link name="base_link">
    <visual>
      <origin xyz="${wheelbase/2} 0 0.4" rpy="0 0 0"/>
      <geometry>
        <box size="2.740 1.060 1.2"/>
      </geometry>
      <material name="white"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="${wheelbase/2} 0 0.4" rpy="0 0 0"/>
      <geometry>
        <box size="2.740 1.060 1.2"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.7 0 0.2" rpy="0 0 0"/>
      <mass value="760.0"/>
      <inertia ixx="100.0" ixy="0.0" ixz="0.0" iyy="100.0" iyz="0.0" izz="100.0"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="prefix x y yaw">
    <link name="${prefix}_wheel">
      <visual>
        <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
        <material name="black"><color rgba="0 0 0 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="15.0"/>
        <inertia ixx="0.3" ixy="0" ixz="0" iyy="0.3" iyz="0" izz="0.5"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} 0" rpy="${yaw} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="rear_right" x="0" y="-${rear_track/2}" yaw="${pi/2}"/>
  <xacro:wheel prefix="rear_left"  x="0" y="${rear_track/2}"  yaw="${pi/2}"/>
  
  <xacro:wheel prefix="front_right" x="${wheelbase}" y="-${front_track/2}" yaw="${pi/2}"/>
  <xacro:wheel prefix="front_left"  x="${wheelbase}" y="${front_track/2}"  yaw="${pi/2}"/>

</robot>
