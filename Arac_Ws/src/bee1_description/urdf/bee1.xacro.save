<?xml version="1.0"?>
<robot name="bee1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="wheel_radius" value="0.265" />
  <xacro:property name="wheel_width" value="0.15" />
  <xacro:property name="wheelbase" value="1.860" />
  <xacro:property name="front_track" value="0.886" />
  <xacro:property name="rear_track" value="0.850" />

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="${wheelbase / 2.0} 0 0.1" rpy="0 0 0"/>
      <geometry><box size="2.74 1.06 0.2"/></geometry>
      <material name="white"><color rgba="1 1 1 1"/></material>
    </visual>
    <visual>
      <origin xyz="1.0 0 0.7" rpy="0 0 0"/>
      <geometry><box size="1.0 1.0 1.2"/></geometry>
    </visual>
    <visual>
      <origin xyz="1.9 0 0.3" rpy="0 0.2 0"/>
      <geometry><box size="0.8 1.0 0.6"/></geometry>
    </visual>
    <visual>
      <origin xyz="0.1 0 0.7" rpy="0 0 0"/>
      <geometry><box size="0.8 1.0 1.2"/></geometry>
    </visual>

    <collision>
      <origin xyz="${wheelbase / 2.0} 0 0.5" rpy="0 0 0"/>
      <geometry><box size="2.74 1.06 1.0"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.7 0 0.3" rpy="0 0 0"/>
      <mass value="760.0"/>
      <inertia ixx="100.0" ixy="0.0" ixz="0.0" iyy="100.0" iyz="0.0" izz="100.0"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="prefix x y">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
        <material name="black"><color rgba="0 0 0 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="15.0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="rear_right" x="0" y="-${rear_track/2}"/>
  <xacro:wheel prefix="rear_left"  x="0" y="${rear_track/2}"/>
  <xacro:wheel prefix="front_right" x="${wheelbase}" y="-${front_track/2}"/>
  <xacro:wheel prefix="front_left"  x="${wheelbase}" y="${front_track/2}"/>
  
  
  <gazebo>
    <plugin name='diff_drive' filename='libgazebo_ros_diff_drive.so'>
      <ros>
        <namespace>/</namespace>
      </ros>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${rear_track}</wheel_separation>
      <wheel_diameter>${wheel_radius * 2}</wheel_diameter>
      <max_wheel_torque>200</max_wheel_torque>
      <max_wheel_acceleration>10.0</max_wheel_acceleration>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_
