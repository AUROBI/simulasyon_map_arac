<?xml version="1.0"?>
<robot name="bee1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="wheel_radius" value="0.265" />
  <xacro:property name="wheel_width" value="0.15" />
  <xacro:property name="wheelbase" value="1.860" />
  <xacro:property name="front_track" value="0.886" />
  <xacro:property name="rear_track" value="0.850" />

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="${wheelbase / 2.0} 0 0.1" rpy="0 0 0"/>
      <geometry><box size="2.74 1.06 0.2"/></geometry>
      <material name="white"><color rgba="1 1 1 1"/></material>
    </visual>
    <visual>
      <origin xyz="1.0 0 0.7" rpy="0 0 0"/>
      <geometry><box size="1.0 1.0 1.2"/></geometry>
    </visual>
    <visual>
      <origin xyz="1.9 0 0.3" rpy="0 0.2 0"/>
      <geometry><box size="0.8 1.0 0.6"/></geometry>
    </visual>
    <visual>
      <origin xyz="0.1 0 0.7" rpy="0 0 0"/>
      <geometry><box size="0.8 1.0 1.2"/></geometry>
    </visual>

    <collision>
      <origin xyz="${wheelbase / 2.0} 0 0.5" rpy="0 0 0"/>
      <geometry><box size="2.74 1.06 1.0"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.7 0 0.3" rpy="0 0 0"/>
      <mass value="760.0"/>
      <inertia ixx="100.0" ixy="0.0" ixz="0.0" iyy="100.0" iyz="0.0" izz="100.0"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="prefix x y">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
        <material name="black"><color rgba="0 0 0 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="15.0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="rear_right" x="0" y="-${rear_track/2}"/>
  <xacro:wheel prefix="rear_left"  x="0" y="${rear_track/2}"/>
  <xacro:wheel prefix="front_right" x="${wheelbase}" y="-${front_track/2}"/>
  <xacro:wheel prefix="front_left"  x="${wheelbase}" y="${front_track/2}"/>

  <!-- SENSÖRLER[cite: 1] -->
  <!-- 1. Velodyne VLP16 LIDAR -->
<link name="lidar_link">
  <visual>
    <geometry>
      <cylinder radius="0.05" length="0.07"/>
    </geometry>
    <material name="black"><color rgba="0 0 0 1"/></material>
  </visual>
</link>

<joint name="lidar_joint" type="fixed">
  <parent link="base_link"/> <!-- Referans: Ön aks merkezi -->
  <child link="lidar_link"/>
  <origin xyz="0.177 0.0 0.620" rpy="0 0 0"/>
</joint>

<!-- 2. ZED2 Stereo Kameralar -->
<!-- Sol Kamera[cite: 2] -->
<link name="camera_left_link">
  <visual>
    <geometry>
      <box size="0.03 0.17 0.03"/>
    </geometry>
    <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  </visual>
</link>

<joint name="camera_left_joint" type="fixed">
  <parent link="base_link"/>
  <child link="camera_left_link"/>
  <origin xyz="-0.205 0.060 0.685" rpy="0 0 0"/>
</joint>

<!-- Sağ Kamera[cite: 2] -->
<link name="camera_right_link">
  <visual>
    <geometry>
      <box size="0.03 0.17 0.03"/>
    </geometry>
    <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  </visual>
</link>

<joint name="camera_right_joint" type="fixed">
  <parent link="base_link"/>
  <child link="camera_right_link"/>
  <origin xyz="-0.205 -0.060 0.685" rpy="0 0 0"/>
</joint>

<!-- 3. XSENS GPS/IMU[cite: 2] -->
<link name="gps_link">
  <visual>
    <geometry>
      <box size="0.05 0.05 0.02"/>
    </geometry>
    <material name="red"><color rgba="1 0 0 1"/></material>
  </visual>
</link>

<joint name="gps_joint" type="fixed">
  <parent link="base_link"/>
  <child link="gps_link"/>
  <origin xyz="-1.440 0.0 1.390" rpy="0 0 0"/>
</joint>

<!-- 4. IMU Link (Yeni Eklendi) -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.05 0.05 0.02"/></geometry>
      <material name="orange"><color rgba="1.0 0.5 0.0 1"/></material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/> <!-- Genelde merkeze yakın yerleştirilir -->
  </joint>

  <!-- GAZEBO EKLENTİLERİ -->
  <gazebo>
    <plugin name='diff_drive' filename='libgazebo_ros_diff_drive.so'>
      <ros><namespace>/</namespace></ros>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${rear_track}</wheel_separation>
      <wheel_diameter>${wheel_radius * 2}</wheel_diameter>
      <max_wheel_torque>200</max_wheel_torque>
      <max_wheel_acceleration>10.0</max_wheel_acceleration>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
    </plugin>
  </gazebo>

<!-- GAZEBO SENSÖR PLUGINLERI (Simülasyon Verisi İçin) -->

<gazebo reference="lidar_link">
  <sensor name="lidar" type="ray">
    <always_on>true</always_on>
    <visualize>true</visualize>
    <update_rate>10</update_rate>
    <ray>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1.000000</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.8</min>
        <max>100.0</max>
      </range>
    </ray>
    <plugin name="gazebo_ros_laser_controller" filename="libgazebo_ros_ray_sensor.so">
      <ros>
        <remapping>~/out:=scan</remapping>
      </ros>
      <output_type>sensor_msgs/LaserScan</output_type>
      <frame_name>lidar_link</frame_name>
    </plugin>
  </sensor>
</gazebo>

<gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <plugin name="imu_controller" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
</gazebo>

<gazebo reference="gps_link">
  <sensor name="gps_sensor" type="gps">
    <always_on>true</always_on>
    <update_rate>1.0</update_rate>
    <plugin name="gps_controller" filename="libgazebo_ros_gps_sensor.so">
      <ros>
        <remapping>~/out:=gps/data</remapping>
      </ros>
      <frame_name>gps_link</frame_name>
    </plugin>
  </sensor>
</gazebo>

<!-- ZED2 Sol Kamera Gazebo Plugini -->
<gazebo reference="camera_left_link">
  <sensor name="camera_left" type="camera">
    <camera>
      <horizontal_fov>1.91986</horizontal_fov> <!-- 110 derece FOV -->
      <image>
        <width>1280</width>
        <height>720</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>100</far>
      </clip>
    </camera>
    <always_on>1</always_on>
    <update_rate>30</update_rate>
    <plugin name="camera_left_controller" filename="libgazebo_ros_camera.so">
      <ros>
        <remapping>~/image_raw:=camera/left/image_raw</remapping>
        <remapping>~/camera_info:=camera/left/camera_info</remapping>
      </ros>
      <camera_name>camera_left</camera_name>
      <frame_name>camera_left_link</frame_name>
    </plugin>
  </sensor>
</gazebo>

<!-- ZED2 Sağ Kamera Gazebo Plugini[cite: 2] -->
<gazebo reference="camera_right_link">
  <sensor name="camera_right" type="camera">
    <camera>
      <horizontal_fov>1.91986</horizontal_fov>
      <image>
        <width>1280</width>
        <height>720</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>100</far>
      </clip>
    </camera>
    <always_on>1</always_on>
    <update_rate>30</update_rate>
    <plugin name="camera_right_controller" filename="libgazebo_ros_camera.so">
      <ros>
        <remapping>~/image_raw:=camera/right/image_raw</remapping>
        <remapping>~/camera_info:=camera/right/camera_info</remapping>
      </ros>
      <camera_name>camera_right</camera_name>
      <frame_name>camera_right_link</frame_name>
    </plugin>
  </sensor>
</gazebo>



</robot>
